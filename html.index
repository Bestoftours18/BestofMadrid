      <div class="qr-box">
        <div id="qrTarget">
          <div class="qr-loading">Génération du QR code…</div>
        </div>
      </div>

      <p class="qr-foot">Compatible <strong>iPhone</strong>, <strong>iPad</strong> et appareils <strong>Android</strong>.</p>
    </section>

    <footer class="footer">
      <div class="rule">bienvenido</div>
      <p>Bienvenue à Madrid — préparez votre voyage en toute confiance.</p>
      <div class="footer-loc">Madrid · España</div>
    </footer>

  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script>
    (function () {
      'use strict';

      var APP_URLS = {
        ios:     'https://apps.apple.com/fr/app/bestof-madrid/id6444720116',
        android: 'https://play.google.com/store/apps/details?id=botler.bestofmadrid'
      };

      function renderQr(target) {
        var url = APP_URLS[target];
        if (!url) return;
        var host = document.getElementById('qrTarget');
        host.innerHTML = '';

        if (typeof QRCode === 'undefined') {
          host.innerHTML = '<div class="qr-loading" style="font-size:11px; text-align:center; padding:0 8px; word-break:break-all;">' + url + '</div>';
          return;
        }
        try {
          new QRCode(host, {
            text: url,
            width: 200,
            height: 200,
            colorDark:  '#001a33',
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.M
          });
        } catch (err) {
          host.innerHTML = '<div class="qr-loading" style="font-size:11px; text-align:center; padding:0 8px; word-break:break-all;">' + url + '</div>';
          console.warn('QR generation failed:', err);
        }
      }

      var tabs = document.querySelectorAll('.qr-tab');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (t) { t.classList.remove('active'); });
          tab.classList.add('active');
          renderQr(tab.dataset.target);
        });
      });

      function init() {
        if (typeof QRCode === 'undefined') {
          setTimeout(init, 200);
          return;
        }
        renderQr('ios');
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>

</body>
</html>
