        <rect x="30" y="104" width="4" height="8" opacity="0.35"/>
        <rect x="42" y="104" width="4" height="8" opacity="0.35"/>

        <!-- Drum base of dome with columns -->
        <rect x="24" y="40" width="28" height="20"/>
