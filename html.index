        <!-- Wings suggestion -->
        <path d="M34 -10 L30 -14 L32 -8 Z"/>
        <path d="M42 -10 L46 -14 L44 -8 Z"/>
      </g>

      <!-- LAYER 7 — PUERTA DE ALCALÁ (neoclassical monumental gate) -->
      <g transform="translate(810 130)">
        <!-- Base -->
        <rect x="0" y="82" width="130" height="20"/>

        <!-- Main body of the gate -->
        <rect x="0" y="30" width="130" height="52"/>

        <!-- Cornice band -->
        <rect x="-2" y="26" width="134" height="6"/>

        <!-- Central pediment (raised above center) -->
        <rect x="45" y="18" width="40" height="8"/>
        <polygon points="43,18 87,18 65,4"/>

        <!-- Central large arch -->
        <path d="M50 82 L50 45 Q50 34 65 34 Q80 34 80 45 L80 82 Z" opacity="0.5"/>

        <!-- Two flanking arches -->
        <path d="M20 82 L20 55 Q20 46 30 46 Q40 46 40 55 L40 82 Z" opacity="0.5"/>
        <path d="M90 82 L90 55 Q90 46 100 46 Q110 46 110 55 L110 82 Z" opacity="0.5"/>

        <!-- Two rectangular openings on far ends -->
        <rect x="4" y="55" width="10" height="27" opacity="0.4"/>
        <rect x="116" y="55" width="10" height="27" opacity="0.4"/>

        <!-- Small columns between arches (Ionic style) -->
        <rect x="15" y="40" width="2" height="42" opacity="0.4"/>
        <rect x="43" y="40" width="2" height="42" opacity="0.4"/>
        <rect x="85" y="40" width="2" height="42" opacity="0.4"/>
        <rect x="113" y="40" width="2" height="42" opacity="0.4"/>

        <!-- Statues on top of the entablature -->
        <rect x="10" y="22" width="2" height="6"/>
        <circle cx="11" cy="21" r="1.5"/>
        <rect x="118" y="22" width="2" height="6"/>
        <circle cx="119" cy="21" r="1.5"/>
        <!-- Central statue on pediment -->
        <circle cx="65" cy="2" r="2"/>
      </g>

      <!-- LAYER 8 — PALACIO DE CIBELES (Neo-Gothic City Hall with central tower) -->
      <g transform="translate(970 62)">
        <!-- Long base -->
        <rect x="0" y="115" width="110" height="55"/>

        <!-- Ground floor arched windows -->
        <path d="M6 165 L6 130 Q6 122 12 122 Q18 122 18 130 L18 165 Z" opacity="0.4"/>
        <path d="M22 165 L22 130 Q22 122 28 122 Q34 122 34 130 L34 165 Z" opacity="0.4"/>
        <path d="M76 165 L76 130 Q76 122 82 122 Q88 122 88 130 L88 165 Z" opacity="0.4"/>
        <path d="M92 165 L92 130 Q92 122 98 122 Q104 122 104 130 L104 165 Z" opacity="0.4"/>

        <!-- Iconic CENTRAL TOWER (matches Palacio de Cibeles' distinctive silhouette) -->
        <rect x="40" y="45" width="30" height="70"/>
        <!-- Tower windows -->
        <rect x="46" y="55" width="6" height="10" opacity="0.35"/>
        <rect x="58" y="55" width="6" height="10" opacity="0.35"/>
        <rect x="46" y="75" width="6" height="10" opacity="0.35"/>
        <rect x="58" y="75" width="6" height="10" opacity="0.35"/>
        <rect x="46" y="95" width="6" height="10" opacity="0.35"/>
        <rect x="58" y="95" width="6" height="10" opacity="0.35"/>

        <!-- Corner pinnacles at tower top -->
        <rect x="38" y="40" width="34" height="5"/>
        <polygon points="36,40 44,40 40,26"/>
        <polygon points="66,40 74,40 70,26"/>
        <line x1="40" y1="26" x2="40" y2="20" stroke="currentColor" stroke-width="1"/>
        <line x1="70" y1="26" x2="70" y2="20" stroke="currentColor" stroke-width="1"/>

        <!-- Central pointed cap -->
        <polygon points="44,40 66,40 55,15"/>
        <line x1="55" y1="15" x2="55" y2="4" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="55" cy="3" r="1.5"/>

        <!-- Smaller corner towers on the wings -->
        <rect x="0" y="95" width="10" height="20"/>
        <polygon points="-2,95 12,95 5,84"/>
        <rect x="100" y="95" width="10" height="20"/>
        <polygon points="98,95 112,95 105,84"/>

        <!-- CIBELES FOUNTAIN in front (chariot with lions, Cybele goddess) -->
        <g transform="translate(28 168)">
          <!-- Fountain basin (rectangular pool) -->
          <ellipse cx="27" cy="18" rx="30" ry="4" opacity="0.4"/>
          <!-- Chariot body -->
          <rect x="14" y="10" width="26" height="6"/>
          <!-- Wheels -->
          <circle cx="16" cy="17" r="3" fill="none" stroke="currentColor" stroke-width="0.8"/>
          <circle cx="38" cy="17" r="3" fill="none" stroke="currentColor" stroke-width="0.8"/>
          <!-- Two lions (simplified) -->
          <path d="M0 12 Q4 8 8 10 L14 10 L14 16 L2 16 Z"/>
          <path d="M40 10 L46 10 Q50 8 54 12 L52 16 L40 16 Z"/>
          <!-- Small heads -->
          <circle cx="4" cy="10" r="1.5"/>
          <circle cx="50" cy="10" r="1.5"/>
          <!-- Cybele goddess on top -->
          <rect x="25" y="4" width="4" height="8"/>
          <circle cx="27" cy="2" r="2"/>
        </g>
      </g>

      <!-- LAYER 9 — Bear + Strawberry Tree monument (Oso y Madroño — Madrid's symbol) -->
      <g transform="translate(1105 190)" opacity="0.85">
        <!-- Pedestal -->
        <rect x="10" y="52" width="16" height="10"/>
        <!-- Tree trunk -->
        <rect x="17" y="20" width="3" height="34"/>
        <!-- Tree canopy (round leafy top) -->
        <circle cx="18" cy="18" r="10"/>
        <!-- Bear standing on hind legs, reaching up -->
        <path d="M4 62 L4 40 Q4 32 12 32 L18 32 L18 62 Z"/>
        <!-- Bear head -->
        <circle cx="12" cy="30" r="4"/>
        <!-- Small ears -->
        <circle cx="9" cy="27" r="1.5"/>
        <circle cx="15" cy="27" r="1.5"/>
        <!-- Bear paw reaching up to strawberries -->
        <ellipse cx="18" cy="22" rx="3" ry="2"/>
        <!-- Small strawberries in tree -->
        <circle cx="14" cy="12" r="1.5" opacity="0.6"/>
        <circle cx="22" cy="14" r="1.5" opacity="0.6"/>
        <circle cx="17" cy="9" r="1.5" opacity="0.6"/>
      </g>

      <!-- LAYER 10 — Plaza foreground band -->
      <rect x="0" y="255" width="1200" height="15"/>

    </svg>
  </div>

  <div class="container">

    <header class="intro">
      <div class="intro-eyebrow">de Madrid au ciel, dans votre poche</div>

      <div class="app-icon-wrap">
        <div class="app-icon-fallback">MAD</div>
        <img
          src="data:image/jpeg;base64,"
          alt="Best of Madrid app icon"
          onload="this.previousElementSibling.style.display='none'"
          onerror="this.style.display='none'">
      </div>

      <h1 class="app-title">Best of <em>Madrid</em></h1>
      <p class="app-tag">Votre guide complet pour explorer Madrid — Palais Royal, Prado, Retiro, tapas et adresses confidentielles.</p>
    </header>

    <section class="stores">

