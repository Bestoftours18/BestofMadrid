      <!-- LAYER 6 — METROPOLIS BUILDING (Edificio Metrópolis — iconic corner Beaux-Arts building with dome) -->
      <g transform="translate(720 90)">
        <!-- Left wing -->
        <rect x="0" y="70" width="24" height="72"/>
        <rect x="4" y="80" width="6" height="10" opacity="0.35"/>
        <rect x="14" y="80" width="6" height="10" opacity="0.35"/>
